database -open waves -into waves.shm -default
probe -create -shm dma_tb.axi_clk dma_tb.dma_clk dma_tb.done dma_tb.done_seen dma_tb.fail_count dma_tb.irq dma_tb.irq_seen dma_tb.pass_count dma_tb.read_data dma_tb.rst_n dma_tb.s_axi_araddr dma_tb.s_axi_arready dma_tb.s_axi_arvalid dma_tb.s_axi_awaddr dma_tb.s_axi_awready dma_tb.s_axi_awvalid dma_tb.s_axi_bready dma_tb.s_axi_bresp dma_tb.s_axi_bvalid dma_tb.s_axi_rdata dma_tb.s_axi_rready dma_tb.s_axi_rresp dma_tb.s_axi_rvalid dma_tb.s_axi_wdata dma_tb.s_axi_wready dma_tb.s_axi_wvalid dma_tb.tc_num dma_tb.timeout
run
run
exit
